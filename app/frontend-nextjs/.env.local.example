# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# LLM: The chat API uses Groq on the Python backend. Set GROQ_API_KEY in
# app/backend/.env — never add GROQ_API_KEY or NEXT_PUBLIC_* API keys here
# (anything NEXT_PUBLIC_ is bundled into the browser and is not secret).

# App settings
NEXT_PUBLIC_APP_NAME=FinBot RAG System
NEXT_PUBLIC_APP_VERSION=1.0.0
